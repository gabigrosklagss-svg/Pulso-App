NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/pulso.db
# Gere com: openssl rand -hex 32 (obrigatório fora de desenvolvimento)
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=168
# Integrações externas (não habilitadas sem credenciais e webhook validado)
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
EMAIL_PROVIDER_API_KEY=replace-me
EMAIL_FROM=nao-responda@example.com
PHONE_PROVIDER_API_KEY=replace-me
IDENTITY_PROVIDER_API_KEY=replace-me
AI_PROVIDER_API_KEY=replace-me
AI_MODEL=configure-from-provider-documentation
TRANSCRIPTION_PROVIDER_API_KEY=replace-me
BUSINESS_LOOKUP_API_KEY=replace-me
SUBSCRIPTION_WEBHOOK_SECRET=replace-me
STORAGE_ENDPOINT=https://storage.example.com
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
PUSH_PRIVATE_KEY=replace-me
SUPPORT_EMAIL=suporte@example.com
